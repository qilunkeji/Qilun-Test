# Local development only. Generate a random 32-byte hex key; never commit real secrets.
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3100
DATA_DIR=.local/database
CONTACT_ENCRYPTION_KEY=
LISTEN_HOST=127.0.0.1
# For LAN H5: set LISTEN_HOST=0.0.0.0 and H5_ORIGIN=http://<this-PC-LAN-IP>:3100.
# Admin API remains loopback-only. Do not expose this HTTP development server to the Internet.
H5_ORIGIN=http://127.0.0.1:3100
# No default users/passwords. Initialize via npm run init.
