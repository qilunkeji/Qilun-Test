# Local development only. Generate a random 32-byte hex key; never commit real secrets.
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3100
DATA_DIR=.local/database
CONTACT_ENCRYPTION_KEY=
LISTEN_HOST=127.0.0.1
# For LAN H5: set LISTEN_HOST=0.0.0.0 and H5_ORIGIN=http://<this-PC-LAN-IP>:3100.
# Admin API remains loopback-only. Do not expose this HTTP development server to the Internet.
H5_ORIGIN=http://127.0.0.1:3100
# External agent framework: integration work in progress; do not enable until acceptance.
PROCESSING_MODE=model
AGENT_WRITE_TOKEN_SHA256=
AGENT_WAKE_WEBHOOK_URL=
AGENT_WAKE_WEBHOOK_SECRET=
AGENT_WAKE_WEBHOOK_AUTH_HEADER=Authorization
AGENT_REPLY_HINT_TEXT=通常 1–3 分钟内完成
AGENT_STALE_ALERT_MINUTES=10
AGENT_REWAKE_AFTER_SECONDS=120
AGENT_WAKE_COALESCE_SECONDS=10
AGENT_TASK_MAX_ATTEMPTS=3
AGENT_HOURLY_LIMIT_PER_USER=20
AGENT_MAX_PENDING_PER_USER=5
AGENT_REDACT_CONTACTS=true
# No default users/passwords. Initialize via npm run init.
