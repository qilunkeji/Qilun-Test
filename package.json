{
  "name": "qilun-talent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types apps/api/main.ts",
    "init": "node --env-file-if-exists=.env --experimental-strip-types scripts/init.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "verify:evidence": "node scripts/verify-evidence.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@qilun/assessment-engine": "workspace:*",
    "@qilun/contracts": "workspace:*",
    "@qilun/iam": "workspace:*",
    "@qilun/security": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "express": "5.2.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "zod": "4.6.5"
  }
}
